{
  "name": "bible-atlas-ai",
  "private": true,
  "version": "1.0.0",
  "description": "Explore biblical journeys, places and events through an interactive map of Scripture.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && tsx scripts/prerender-pages.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:browsers": "E2E_ALL_BROWSERS=1 playwright test --project=firefox",
    "check": "npm run typecheck && npm run lint && npm run test",
    "data:sources": "tsx scripts/fetch-sources.ts",
    "data:scripture": "tsx scripts/build-scripture.ts",
    "data:verify": "tsx scripts/verify-places.ts",
    "data:passage": "tsx scripts/show-passage.ts",
    "data:find-place": "tsx scripts/find-place.ts",
    "data:embeddings": "tsx scripts/build-embeddings.ts",
    "og:image": "tsx scripts/render-og-image.ts",
    "map:poster": "tsx scripts/render-poster.ts",
    "qa:lighthouse": "tsx scripts/qa-lighthouse.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "lucide-react": "^1.58.0",
    "maplibre-gl": "^6.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lighthouse": "13.5.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
